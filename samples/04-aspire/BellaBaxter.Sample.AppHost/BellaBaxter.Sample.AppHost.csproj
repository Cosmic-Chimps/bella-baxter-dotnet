<Project Sdk="Aspire.AppHost.Sdk/13.5.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- Bella Aspire integration — AddBaxter() + WithReference() -->
    <PackageReference Include="BellaBaxter.Aspire.Configuration" Version="0.1.1-preview.111" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BellaBaxter.Sample.Api\BellaBaxter.Sample.Api.csproj">
      <IsAspireProjectResource>true</IsAspireProjectResource>
    </ProjectReference>
  </ItemGroup>
</Project>
