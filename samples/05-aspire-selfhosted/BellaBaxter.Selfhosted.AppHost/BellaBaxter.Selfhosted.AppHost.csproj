<Project Sdk="Aspire.AppHost.Sdk/13.5.4">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- Full Bella Baxter stack — AddBellaBaxter() starts Postgres, Redis, Keycloak, OpenBao, Bella API -->
    <PackageReference Include="BellaBaxter.Aspire.Host" Version="0.1.1-preview.111" />
    <!-- Postgres + Redis hosting packages (for bring-your-own usage) -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.5.4" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.5.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\BellaBaxter.Selfhosted.Api\BellaBaxter.Selfhosted.Api.csproj">
      <IsAspireProjectResource>true</IsAspireProjectResource>
    </ProjectReference>
  </ItemGroup>
</Project>
